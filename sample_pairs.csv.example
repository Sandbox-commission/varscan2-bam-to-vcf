# Format: case_bam,control_bam[,tumor_purity]  (one pair per line, no header row)
# Column 1: case (tumour) BAM filename
# Column 2: control (normal) BAM filename
# Column 3 (optional): per-sample tumor purity (0.0–1.0); overrides [somatic] tumor_purity in config.toml
# Filenames are stripped of pairs_suffix (default: _final.bam) to derive sample names.
case01_final.bam,control01_final.bam,0.65
case02_final.bam,control02_final.bam,0.80
case03_final.bam,control03_final.bam
